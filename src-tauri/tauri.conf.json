{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Token Ledger",
  "version": "0.9.1",
  "identifier": "com.tokenledger.app",
  "build": {
    "frontendDist": "../ui",
    "beforeBuildCommand": "node scripts/build-ui.mjs",
    "beforeDevCommand": "node scripts/build-ui.mjs"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "title": "Token 账本",
        "width": 1120,
        "height": 860,
        "minWidth": 820,
        "minHeight": 600,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": []
  }
}
